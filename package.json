{
  "name": "renny-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && npm run rewrites && vite build",
    "postbuild": "node patch-react-snap.cjs && react-snap && node -e \"['ec','green-steel','document'].forEach(d => require('fs').rmSync('dist/' + d, { recursive: true, force: true }))\"",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "rewrites": "node scripts/generate-rewrites.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.2.8",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "aos": "^2.3.4",
    "axios": "^1.13.2",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.2",
    "react": "^18.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.0",
    "react-parallax": "^3.5.2",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.10.1",
    "react-simple-maps": "^3.0.0",
    "react-toastify": "^11.0.5",
    "swiper": "^12.0.3",
    "tailwindcss": "^4.1.18",
    "topojson-client": "^3.1.0",
    "vite-plugin-svgr": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react-snap": "^1.23.0",
    "vite": "^7.2.4"
  },
  "reactSnap": {
    "source": "dist",
    "inlineCss": false,
    "waitFor": 5000,
    "include": [
      "/catelog-download",
      "/scaffolding-brochure"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-web-security",
      "--user-data-dir=./node_modules/.cache/react-snap-chrome"
    ]
  }
}
